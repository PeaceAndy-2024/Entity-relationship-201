CREATE DATABASE EcommerceDB;
USE DATABASE EcommerceSB;
```
CREATE TABLE brand (
    brand_id INT AUTO_INCREMENT,
    brand_name VARCHAR(100) NOT NULL,
    PRIMARY KEY (brand_id)
);

CREATE TABLE product_category (
    category_id INT AUTO_INCREMENT,
    category_name VARCHAR(100) NOT NULL,
    PRIMARY KEY (category_id)
);

CREATE TABLE attribute_category (
    attribute_category_id INT AUTO_INCREMENT,
    category_name VARCHAR(100) NOT NULL,
    PRIMARY KEY (attribute_category_id)
);

CREATE TABLE attribute_type (
    attribute_type_id INT AUTO_INCREMENT,
    attribute_category_id INT,
    type_name VARCHAR(50) NOT NULL,
    PRIMARY KEY (attribute_type_id),
    FOREIGN KEY (attribute_category_id) REFERENCES attribute_category(attribute_category_id)
);

CREATE TABLE color (
    color_id INT AUTO_INCREMENT,
    color_name VARCHAR(50) NOT NULL,
    color_code VARCHAR(10),
    PRIMARY KEY (color_id)
);

CREATE TABLE size_category (
    size_category_id INT AUTO_INCREMENT,
    category_name VARCHAR(100) NOT NULL,
    PRIMARY KEY (size_category_id)
);

CREATE TABLE size_option (
    size_option_id INT AUTO_INCREMENT,
    size_category_id INT,
    size_value VARCHAR(20) NOT NULL,
    PRIMARY KEY (size_option_id),
    FOREIGN KEY (size_category_id) REFERENCES size_category(size_category_id)
);

CREATE TABLE product (
    product_id INT AUTO_INCREMENT,
    product_name VARCHAR(255) NOT NULL,
    brand_id INT,
    base_price DECIMAL(10, 2) NOT NULL,
    category_id INT,
    PRIMARY KEY (product_id),
    FOREIGN KEY (brand_id) REFERENCES brand(brand_id),
    FOREIGN KEY (category_id) REFERENCES product_category(category_id)
);

CREATE TABLE product_attribute (
    attribute_id INT AUTO_INCREMENT,
    product_id INT,
    attribute_type_id INT,
    attribute_value VARCHAR(255) NOT NULL,
    PRIMARY KEY (attribute_id),
    FOREIGN KEY (product_id) REFERENCES product(product_id),
    FOREIGN KEY (attribute_type_id) REFERENCES attribute_type(attribute_type_id)
);

CREATE TABLE product_variation (
    variation_id INT AUTO_INCREMENT,
    product_id INT,
    color_id INT,
    size_option_id INT,
    PRIMARY KEY (variation_id),
    FOREIGN KEY (product_id) REFERENCES product(product_id),
    FOREIGN KEY (color_id) REFERENCES color(color_id),
    FOREIGN KEY (size_option_id) REFERENCES size_option(size_option_id)
);

CREATE TABLE product_item (
    item_id INT AUTO_INCREMENT,
    product_id INT,
    variation_id INT,
    PRIMARY KEY (item_id),
    FOREIGN KEY (product_id) REFERENCES product(product_id),
    FOREIGN KEY (variation_id) REFERENCES product_variation(variation_id)
);

CREATE TABLE product_image (
    image_id INT AUTO_INCREMENT,
    product_id INT,
    image_url VARCHAR(255) NOT NULL,
    PRIMARY KEY (image_id),
    FOREIGN KEY (product_id) REFERENCES product(product_id)
);

